[Unit]
Description=Qwen inference gateway for Mars laptop over Tailscale
After=qwen-inference.service
Wants=qwen-inference.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-%h/.config/t3-master/qwen-gateway.env
ExecStart=/usr/bin/python3 %h/.local/share/qwen-inference/tailnet-gateway.py
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=default.target
